<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/completionsuspend/db" VERSION="20260829" COMMENT="XMLDB file for local_completionsuspend"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_completionsuspend_target" COMMENT="Courses and categories enabled for auto-suspend">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="targettype" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="course or category"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_target" UNIQUE="true" FIELDS="targettype, targetid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_completionsuspend_log" COMMENT="Audit log of suspension and re-activation actions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="enrolid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="action" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="suspended, reactivated, simulated"/>
        <FIELD NAME="triggertype" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="event" COMMENT="event or task"/>
        <FIELD NAME="simulated" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="enroltimemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="user_enrolments.timemodified at the moment we suspended, used to detect later external changes"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_user_course" UNIQUE="false" FIELDS="userid, courseid"/>
        <INDEX NAME="idx_course_action" UNIQUE="false" FIELDS="courseid, action, simulated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
